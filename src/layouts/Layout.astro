---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "TradeCheckPH — regulation-first forex broker and prop firm guides for Filipino traders." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | TradeCheckPH</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TradeCheckPH" />
    <meta property="og:title" content={`${title} | TradeCheckPH`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | TradeCheckPH`} />
    <meta name="twitter:description" content={description} />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">TradeCheckPH</a>
      <nav>
        <a href="/guides/">Guides</a>
        <a href="/broker-reviews/">Broker Reviews</a>
        <a href="/prop-firms/">Prop Firms</a>
        <a href="/tools/broker-checklist/">Broker Checklist Tool</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>TradeCheckPH publishes educational content about forex brokers and prop firms for traders in the Philippines. Nothing on this site is investment, legal, or tax advice. Always verify broker licenses directly on the regulator's official register and check the current SEC Philippines advisory list before depositing funds.</p>
      <p><strong>Affiliate disclosure:</strong> TradeCheckPH may earn a commission if you sign up with a broker or prop firm through a link on this site, at no extra cost to you. This does not affect the accuracy of our regulatory or educational content, and we do not accept payment to publish specific numbers, claims, or a favorable review. See our editorial policy on how we handle unreviewed brokers in the <a href="/broker-reviews/">Broker Reviews</a> section.</p>
    </footer>
  </body>
</html>
